# Standalone FPV of the DSQ co-processor.
#   sby -f dsq_unit.sby prove   -> unbounded proof (k-induction)
#   sby -f dsq_unit.sby cover   -> reachability of cover points (non-vacuity)
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 6

[engines]
smtbmc bitwuzla

[script]
read -formal pcpi_dsq_tapeout.v
read -formal dsq_unit_props.sv
prep -top dsq_unit_props

[files]
pcpi_dsq_tapeout.v
dsq_unit_props.sv
